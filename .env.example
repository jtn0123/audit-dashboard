# Copy to .env and fill in. Only GITHUB_TOKEN is required.
# .env is gitignored; this file is not, so keep real values out of it.
#
# There is no dotenv loader — variables are read from the process environment.
# Docker Compose reads .env automatically and interpolates it into the
# `environment:` block; Portainer git stacks use stack env vars the same way.
# For a bare `node server.js` run, export them or pass them inline:
#   PORT=3002 GITHUB_TOKEN=ghp_... node server.js

# --- GitHub access -------------------------------------------------------
# Fine-grained PAT (read-only) with repository permissions:
#   Metadata: Read · Dependabot alerts: Read · Pull requests: Read
#   Contents: Read · Actions: Read · Administration: Read (for security settings)
# A classic PAT with `repo` + `security_events` also works.
GITHUB_TOKEN=

# --- What to scan --------------------------------------------------------
# Leave GH_OWNERS empty to scan every repo the token can see.
# NOTE: setting GH_OWNERS to your own username lists only your PUBLIC repos
# (GitHub's /users/{owner}/repos endpoint). To scope to your repos and keep
# private ones, leave GH_OWNERS empty and use GH_REPOS_INCLUDE=you/* instead.
# GH_OWNERS=jtn0123,my-org
# GH_REPOS_INCLUDE=jtn0123/*          # comma-separated globs; empty = everything
# GH_REPOS_EXCLUDE=*/scratch-*,*/dotfiles
# GH_INCLUDE_ARCHIVED=false
# GH_INCLUDE_FORKS=false
# GH_INCLUDE_PRIVATE=true
# GH_MAX_REPOS=300

# --- Polling -------------------------------------------------------------
# GH_REFRESH_MINUTES=30               # minimum 5
# GH_STALE_DAYS=14                    # a repo unscanned for longer is flagged stale
# GH_CONCURRENCY=6                    # parallel repo fetches
# GH_AUTO_REFRESH=true                # false = manual "Rescan" only
# GH_CACHE_FILE=/cache/github.json

# --- Scan history --------------------------------------------------------
# GitHub cannot answer "how many alerts were open last Tuesday", so every scan
# appends a local snapshot. That series is what Trends, History and Calendar
# chart. It lives on the same cache volume; deleting it loses the recorded
# history (the derived series reconstructed from open alerts still works).
# GH_HISTORY_FILE=/cache/history.json
# GH_HISTORY_DAYS=180                 # retention; minimum 7

# --- Server --------------------------------------------------------------
# PORT=3002
# HOST_BIND=127.0.0.1                 # compose only: host interface the port binds to.
#                                     # 127.0.0.1 = this box only (default).
#                                     # Set to the box's LAN IP for LAN access.
#                                     # Never a WAN-facing interface.
# ALLOWED_ORIGINS=http://nas.local:3002
# GITHUB_API_URL=https://api.github.com   # change for GitHub Enterprise
