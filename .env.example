# audit-dashboard configuration.
# Copy to .env and adjust. .env is gitignored; this file is not, so keep real
# values out of it.
#
# Both variables are read directly from the process environment in server.js;
# there is no dotenv loader, so either export them or pass them inline:
#   DATA_DIR=/path/to/audits PORT=3002 node server.js

# Path to the audit data root -- the directory that contains the YYYY-MM-DD/
# subdirectories of *.json reports.
# Default when unset: the parent directory of the repo (server.js uses `..`).
DATA_DIR=/path/to/audits

# Port the Express server listens on.
# Default when unset: 3000 (server.js). Note docker-compose.yml and the README
# both use 3002, so set this explicitly if you want to match them.
PORT=3002
