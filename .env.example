# Copy to .env and fill in. Only GITHUB_TOKEN is required.
# .env is gitignored; this file is not, so keep real values out of it.
#
# There is no dotenv loader — variables are read from the process environment.
# Docker Compose loads .env automatically (env_file); for a bare `node server.js`
# run, export them or pass them inline:
#   DATA_DIR=/path/to/audits PORT=3002 node server.js

# --- GitHub access -------------------------------------------------------
# Fine-grained PAT (read-only) with repository permissions:
#   Metadata: Read · Dependabot alerts: Read · Pull requests: Read
#   Contents: Read · Actions: Read · Administration: Read (for security settings)
# A classic PAT with `repo` + `security_events` also works.
GITHUB_TOKEN=

# --- What to scan --------------------------------------------------------
# Leave GH_OWNERS empty to scan every repo the token can see.
# GH_OWNERS=jtn0123,my-org
# GH_REPOS_INCLUDE=jtn0123/*          # comma-separated globs; empty = everything
# GH_REPOS_EXCLUDE=*/scratch-*,*/dotfiles
# GH_INCLUDE_ARCHIVED=false
# GH_INCLUDE_FORKS=false
# GH_INCLUDE_PRIVATE=true
# GH_MAX_REPOS=300

# --- Polling -------------------------------------------------------------
# GH_REFRESH_MINUTES=30               # minimum 5
# GH_STALE_DAYS=14                    # a repo unscanned for longer is flagged stale
# GH_CONCURRENCY=6                    # parallel repo fetches
# GH_AUTO_REFRESH=true                # false = manual "Rescan" only
# GH_CACHE_FILE=/cache/github.json

# --- Patch budgets -------------------------------------------------------
# How long an open alert of each severity is allowed to sit before the board
# calls it out. Set a value to 0 to allow no grace at all.
# GH_SLA_CRITICAL_DAYS=7
# GH_SLA_HIGH_DAYS=30
# GH_SLA_MEDIUM_DAYS=90
# GH_SLA_LOW_DAYS=180

# --- What to collect -----------------------------------------------------
# Each is a separate API call per repo; turn off what you don't need (or
# whose token scope you'd rather not grant).
# GH_COLLECT_CODE_SCANNING=true       # CodeQL findings
# GH_COLLECT_SECRET_SCANNING=true     # leaked credentials
# GH_COLLECT_CI=true                  # default-branch CI conclusion
# GH_COLLECT_DOCKERFILES=true         # Dockerfiles with no docker ecosystem
# GH_COLLECT_DISMISSED=true           # dismissed alerts + why
# GH_COLLECT_SBOM=true                # dependency graph, for cross-repo package search
# GH_MAX_PACKAGES_PER_REPO=3000

# --- History -------------------------------------------------------------
# One snapshot per scan, behind the Timeline view and the "since your last
# visit" banner.
# GH_HISTORY_FILE=/cache/history.jsonl
# GH_HISTORY_DAYS=180

# --- Writes (off by default) ---------------------------------------------
# Enables merging green Dependabot PRs from the board. Requires a token with
# Pull requests: Read and write. Leave unset for a strictly read-only deploy.
# GH_ALLOW_WRITES=false

# --- Webhook (optional) --------------------------------------------------
# Set a random secret and point a GitHub webhook at /api/gh/webhook to get
# alerts pushed in instead of waiting for the next poll. Unset = endpoint off.
# GH_WEBHOOK_SECRET=

# --- Server --------------------------------------------------------------
# PORT=3002
# DATA_DIR=/path/to/audits            # audit reports dir read by server.js
#                                     # (compose sets this to /data in-container)
# AUDIT_DATA_DIR=/home/you/audits     # host path compose mounts at /data (compose only)
# ALLOWED_ORIGINS=http://nas.local:3002
# GITHUB_API_URL=https://api.github.com   # change for GitHub Enterprise
